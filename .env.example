# ─── Django ───────────────────────────────────────────────────────────────────
SECRET_KEY=your-strong-secret-key-here
DEBUG=False

# Space-separated list of allowed hosts
# Vercel backend URL + localhost for dev
ALLOWED_HOSTS=your-backend.vercel.app localhost 127.0.0.1

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Space-separated list — *.vercel.app subdomains are covered automatically by regex
# Add your exact production frontend URL here too
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ─── CSRF ─────────────────────────────────────────────────────────────────────
# Must include your Vercel backend domain
CSRF_TRUSTED_ORIGINS=https://your-backend.vercel.app https://your-frontend.vercel.app
